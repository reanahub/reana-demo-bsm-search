import hashlib
import json
import math
import re

configfile: "workflow/config.yaml"


WORKDIR = config["workdir"]
BACKGROUND_SAMPLES = list(config["backgrounds"])
SYSTEMATICS = config["systematics"]
RANDOM_SEED = config["random_seed"]


def shell_with_directories(command):
    """Prepare output and log parents before a remote REANA job starts.

    Snakemake normally creates these directories before executing a shell rule.
    REANA's Snakemake 9 remote executor currently submits the raw command
    without that preparation, so each remote job must perform it itself. Keep
    this compatibility wrapper centralized so it can be removed once the
    executor restores the standard Snakemake behaviour.
    """
    return (
        f"mkdir -p $(dirname {{output:q}}) $(dirname {{log:q}})\n"
        f"{command}"
    )


def systematic_variations(systematic_type):
    return [
        variation["name"]
        for systematic in SYSTEMATICS[systematic_type].values()
        for variation in (systematic["up"], systematic["down"])
    ]


def variation_definitions():
    definitions = {}
    for variation_type, systematics in SYSTEMATICS.items():
        for systematic in systematics.values():
            for variation in (systematic["up"], systematic["down"]):
                name = variation["name"]
                if name in definitions:
                    raise ValueError(f"Duplicate systematic variation name: {name}")
                shift = variation.get("shift")
                if shift is not None and shift[0] > shift[1]:
                    raise ValueError(
                        f"Invalid shift range for {name}: {shift}"
                    )
                definitions[name] = {
                    "type": variation_type,
                    **{
                        key: value
                        for key, value in variation.items()
                        if key != "name"
                    },
                }
    return definitions


SHAPE_VARIATIONS = systematic_variations("shape")
WEIGHT_VARIATIONS = ["nominal", *systematic_variations("weight")]
VARIATION_CONFIG = json.dumps(variation_definitions(), sort_keys=True)
SHAPE_VARIATION_PATTERN = (
    "|".join(map(re.escape, SHAPE_VARIATIONS)) or r"(?!)"
)
SAMPLE_PATTERN = "|".join(
    map(re.escape, ["data", "signal", *BACKGROUND_SAMPLES])
)
BACKGROUND_PATTERN = "|".join(map(re.escape, BACKGROUND_SAMPLES))
PLOT_COMPONENTS = ",".join(["qcd", *reversed(BACKGROUND_SAMPLES), "signal"])
DATA_FRACTION_SUM = config["data"]["qcd_fraction"] + sum(
    sample["data_fraction"] for sample in config["backgrounds"].values()
)
if not math.isclose(DATA_FRACTION_SUM, 1.0, rel_tol=0.0, abs_tol=1e-9):
    raise ValueError(
        "Background data fractions and data.qcd_fraction must sum to 1, "
        f"but sum to {DATA_FRACTION_SUM}"
    )

MODEL_CONFIG = json.dumps(
    {
        "backgrounds": BACKGROUND_SAMPLES,
        "systematics": SYSTEMATICS,
    },
    sort_keys=True,
)
GENERATOR_CONFIG = json.dumps(
    {
        "samples": {
            **{
                sample: sample_config["generator"]
                for sample, sample_config in config["backgrounds"].items()
            },
            "qcd": config["data"]["qcd_generator"],
            "sig": config["signal"]["generator"],
        },
        "data": {
            "control_region_fraction": config["data"][
                "control_region_fraction"
            ],
            "signal_region_composition": {
                **{
                    sample: sample_config["data_fraction"]
                    for sample, sample_config in config["backgrounds"].items()
                },
                "qcd": config["data"]["qcd_fraction"],
            },
        },
    },
    sort_keys=True,
)

GENERATED_BATCH_SIZE = {
    "data": 6,
    "signal": 2,
    **{sample: 2 for sample in BACKGROUND_SAMPLES},
}


def generated_count(sample):
    if sample == "data":
        return len(config["data"]["nevents"])
    if sample == "signal":
        return len(config["signal"]["nevents"])
    return len(config["backgrounds"][sample]["nevents"])


def generated_batches(sample):
    return range(math.ceil(generated_count(sample) / GENERATED_BATCH_SIZE[sample]))


def derived_seed(*parts):
    """Derive a stable job-specific seed, or disable seeding with -1."""
    if RANDOM_SEED < 0:
        return -1
    seed_material = ":".join(map(str, (RANDOM_SEED, *parts))).encode()
    return int.from_bytes(hashlib.sha256(seed_material).digest()[:4], "big")


def generated_files_for_batch(wildcards):
    sample = wildcards.sample
    batch = int(wildcards.batch)
    batch_size = GENERATED_BATCH_SIZE[sample]
    start = batch * batch_size
    stop = min(start + batch_size, generated_count(sample))
    return expand(
        f"{WORKDIR}/generated/{{sample}}/{{chunk}}.root",
        sample=sample,
        chunk=range(start, stop),
    )


def nevents_for_chunk(wildcards):
    chunk = int(wildcards.chunk)
    if wildcards.sample == "data":
        return config["data"]["nevents"][chunk]
    if wildcards.sample == "signal":
        return config["signal"]["nevents"][chunk]
    return config["backgrounds"][wildcards.sample]["nevents"][chunk]


def generator_type(wildcards):
    return "sig" if wildcards.sample == "signal" else wildcards.sample


def sample_weight(sample):
    if sample == "signal":
        return config["signal"]["weight"]
    return config["backgrounds"][sample]["weight"]


def selected_batch_files(sample, selection_group):
    return expand(
        f"{WORKDIR}/selected/{{sample}}/{{selection_group}}/batch{{batch}}.root",
        sample=sample,
        selection_group=selection_group,
        batch=generated_batches(sample),
    )


wildcard_constraints:
    batch = r"\d+",
    chunk = r"\d+",
    region = r"signal|control",
    sample = SAMPLE_PATTERN,
    shapevar = SHAPE_VARIATION_PATTERN,


rule all:
    input:
        "plot/prefit.pdf",
        "plot/postfit.pdf",
        "hepdata/submission.zip",


# Files below WORKDIR are intermediate products. Marking them as temp() tells
# Snakemake to remove each file after its final consumer has completed. This
# keeps the shared workspace small without hard-coding a cleanup stage.
rule generate:
    input:
        script="code/generantuple.py",
    output:
        temp(f"{WORKDIR}/generated/{{sample}}/{{chunk}}.root"),
    params:
        gentype=generator_type,
        nevents=nevents_for_chunk,
        generator_config=GENERATOR_CONFIG,
        seed=lambda wildcards: derived_seed(
            "generate", wildcards.sample, wildcards.chunk
        ),
    log:
        "logs/generate/{sample}/{chunk}.log",
    container:
        config["containers"]["analysis"]
    shell:
        shell_with_directories("""
        (
            python3 {input.script:q} {params.gentype:q} {params.nevents} {output:q} {params.seed} {params.generator_config:q}
        ) 2>&1 | tee {log:q}
        """)


rule merge_generated:
    input:
        generated_files_for_batch,
    output:
        temp(f"{WORKDIR}/merged/generated/{{sample}}/batch{{batch}}.root"),
    log:
        "logs/merge_generated/{sample}/batch{batch}.log",
    container:
        config["containers"]["root"]
    shell:
        shell_with_directories("""
        (
            hadd -f {output:q} {input:q}
        ) 2>&1 | tee {log:q}
        """)


rule select_data:
    input:
        data=f"{WORKDIR}/merged/generated/data/batch{{batch}}.root",
        script="code/select.py",
    output:
        temp(f"{WORKDIR}/selected/data/{{region}}/batch{{batch}}.root"),
    params:
        variations="nominal",
    log:
        "logs/select_data/{region}/batch{batch}.log",
    container:
        config["containers"]["analysis"]
    shell:
        shell_with_directories("""
        (
            python3 {input.script:q} {input.data:q} {output:q} {wildcards.region:q} {params.variations:q}
        ) 2>&1 | tee {log:q}
        """)


rule merge_selected_data:
    input:
        lambda wildcards: selected_batch_files("data", wildcards.region),
    output:
        temp(f"{WORKDIR}/merged/selected/data/{{region}}.root"),
