import math


configfile: "workflow/config.yaml"

shell.executable("/bin/bash")


WORKDIR = config["workdir"]
BACKGROUND_SAMPLES = list(config["backgrounds"])
SHAPE_VARIATIONS = config["shape_variations"]
WEIGHT_VARIATIONS = config["weight_variations"]
SHAPE_VARIATION_PATTERN = "|".join(SHAPE_VARIATIONS)

GENERATED_BATCH_SIZE = {
    "data": 6,
    "signal": 2,
    **{sample: 2 for sample in BACKGROUND_SAMPLES},
}


def generated_count(sample):
    if sample == "data":
        return len(config["data"]["nevents"])
    if sample == "signal":
        return len(config["signal"]["nevents"])
    return len(config["backgrounds"][sample]["nevents"])


def generated_batches(sample):
    return range(math.ceil(generated_count(sample) / GENERATED_BATCH_SIZE[sample]))


def generated_files_for_batch(wildcards):
    sample = wildcards.sample
    batch = int(wildcards.batch)
    batch_size = GENERATED_BATCH_SIZE[sample]
    start = batch * batch_size
    stop = min(start + batch_size, generated_count(sample))
    return expand(
        WORKDIR + "/generated/{sample}/{chunk}.root",
        sample=sample,
        chunk=range(start, stop),
    )


def nevents_for_chunk(wildcards):
    chunk = int(wildcards.chunk)
    if wildcards.sample == "data":
        return config["data"]["nevents"][chunk]
    if wildcards.sample == "signal":
        return config["signal"]["nevents"][chunk]
    return config["backgrounds"][wildcards.sample]["nevents"][chunk]


def generator_type(wildcards):
    return "sig" if wildcards.sample == "signal" else wildcards.sample


def sample_weight(sample):
    if sample == "signal":
        return config["signal"]["weight"]
    return config["backgrounds"][sample]["weight"]


def selected_batch_files(sample, selection_group):
    return expand(
        WORKDIR + "/selected/{sample}/{selection_group}/batch{batch}.root",
        sample=sample,
        selection_group=selection_group,
        batch=generated_batches(sample),
    )


wildcard_constraints:
    batch = r"\d+",
    chunk = r"\d+",
    shapevar = SHAPE_VARIATION_PATTERN,


rule all:
    input:
        "plot/prefit.pdf",
        "plot/postfit.pdf",
        "hepdata/submission.zip",


rule generate:
    output:
        WORKDIR + "/generated/{sample}/{chunk}.root",
    params:
        gentype=generator_type,
        nevents=nevents_for_chunk,
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/generantuple.py {params.gentype} {params.nevents} {output}
        """


rule merge_generated:
    input:
        generated_files_for_batch,
    output:
        WORKDIR + "/merged/generated/{sample}/batch{batch}.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


rule select_data:
    input:
        WORKDIR + "/merged/generated/data/batch{batch}.root",
    output:
        WORKDIR + "/selected/data/{region}/batch{batch}.root",
    params:
        variations="nominal",
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/select.py {input} {output} {wildcards.region} {params.variations}
        """


rule merge_selected_data:
    input:
        lambda wildcards: selected_batch_files("data", wildcards.region),
    output:
        WORKDIR + "/merged/selected/data/{region}.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


rule histogram_data:
    input:
        WORKDIR + "/merged/selected/data/{region}.root",
    output:
        WORKDIR + "/hist/data/{region}.root",
    params:
        name=lambda wildcards: "data" if wildcards.region == "signal" else "qcd",
        weight=lambda wildcards: 1.0
        if wildcards.region == "signal"
        else config["data"]["qcd_transfer_factor"],
        variations="nominal",
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/histogram.py {input} {output} {params.name} {params.weight} {params.variations}
        """


rule merge_data_histograms:
    input:
        WORKDIR + "/hist/data/signal.root",
        WORKDIR + "/hist/data/control.root",
    output:
        WORKDIR + "/hists/data.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


rule select_signal:
    input:
        WORKDIR + "/merged/generated/signal/batch{batch}.root",
    output:
        WORKDIR + "/selected/signal/nominal/batch{batch}.root",
    params:
        variations="nominal",
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/select.py {input} {output} signal {params.variations}
        """


rule merge_selected_signal:
    input:
        lambda wildcards: selected_batch_files("signal", "nominal"),
    output:
        WORKDIR + "/merged/selected/signal/nominal.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


rule histogram_signal:
    input:
        WORKDIR + "/merged/selected/signal/nominal.root",
    output:
        WORKDIR + "/hist/signal/nominal.root",
    params:
        name="signal",
        weight=lambda wildcards: sample_weight("signal"),
        variations="nominal",
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/histogram.py {input} {output} {params.name} {params.weight} {params.variations}
        """


rule merge_signal_histograms:
    input:
        WORKDIR + "/hist/signal/nominal.root",
    output:
        WORKDIR + "/hists/signal.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


