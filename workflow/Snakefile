rule make_workspace:
    input:
        histograms=f"{WORKDIR}/hists/data_bkg_signal.root",
        source_config="workflow/config.yaml",
        script="code/makews.py",
    output:
        workspace="results/workspace_combined_meas_model.root",
        xml=directory("xmldir"),
    params:
        model_config=MODEL_CONFIG,
    log:
        "logs/make_workspace.log",
    container:
        config["containers"]["analysis"]
    shell:
        shell_with_directories("""
        (
            workspace_prefix={output.workspace:q}
            workspace_prefix="${{workspace_prefix%_combined_meas_model.root}}"
            mkdir -p "$(dirname {output.workspace:q})" {output.xml:q}
            python3 {input.script:q} {input.histograms:q} "$workspace_prefix" {output.xml:q} {params.model_config:q}
        ) 2>&1 | tee {log:q}
        """)


rule plot:
    input:
        workspace="results/workspace_combined_meas_model.root",
    output:
        nominal_vals="plot/nominal_vals.yml",
        fit_results="plot/fit_results.yml",
        prefit="plot/prefit.pdf",
        postfit="plot/postfit.pdf",
    params:
        components=PLOT_COMPONENTS,
    log:
        "logs/plot.log",
    container:
        config["containers"]["analysis"]
    shell:
        shell_with_directories("""
        (
            mkdir -p plot
            hfquickplot write-vardef {input.workspace:q} combined {output.nominal_vals:q}
            hfquickplot plot-channel {input.workspace:q} combined channel1 x {output.nominal_vals:q} -c {params.components:q} -o {output.prefit:q}
            hfquickplot fit {input.workspace:q} combined {output.fit_results:q}
            hfquickplot plot-channel {input.workspace:q} combined channel1 x {output.fit_results:q} -c {params.components:q} -o {output.postfit:q}
        ) 2>&1 | tee {log:q}
        """)


rule hepdata:
    input:
        workspace="results/workspace_combined_meas_model.root",
        script="code/hepdata_export.py",
    output:
        zip="hepdata/submission.zip",
        submission="hepdata/submission.yaml",
        data="hepdata/data1.yaml",
    params:
        model_config=MODEL_CONFIG,
    log:
        "logs/hepdata.log",
    container:
        config["containers"]["analysis"]
    shell:
        shell_with_directories("""
        (
            mkdir -p hepdata
            python3 {input.script:q} {input.workspace:q} {output.submission:q} {output.data:q} {params.model_config:q}
            zip -j {output.zip:q} {output.submission:q} {output.data:q}
        ) 2>&1 | tee {log:q}
        """)
