    input:
        WORKDIR + "/merged/generated/{sample}/batch{batch}.root",
    output:
        WORKDIR + "/selected/{sample}/weights/batch{batch}.root",
    params:
        variations=",".join(WEIGHT_VARIATIONS),
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/select.py {input} {output} signal {params.variations}
        """


