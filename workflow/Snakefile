            hadd -f {output:q} {input:q}
        ) 2>&1 | tee {log:q}
        """)


rule histogram_data:
    input:
        data=f"{WORKDIR}/merged/selected/data/{{region}}.root",
        script="code/histogram.py",
    output:
        temp(f"{WORKDIR}/hist/data/{{region}}.root"),
    params:
        name=lambda wildcards: "data" if wildcards.region == "signal" else "qcd",
        weight=lambda wildcards: 1.0
        if wildcards.region == "signal"
        else config["data"]["qcd_transfer_factor"],
        variations="nominal",
    log:
        "logs/histogram_data/{region}.log",
    container:
        config["containers"]["analysis"]
    shell:
        shell_with_directories("""
        (
            python3 {input.script:q} {input.data:q} {output:q} {params.name:q} {params.weight} {params.variations:q}
        ) 2>&1 | tee {log:q}
        """)


