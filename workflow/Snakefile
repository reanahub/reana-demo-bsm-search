        temp(f"{WORKDIR}/selected/{{sample}}/weights/batch{{batch}}.root"),
    params:
        variations=",".join(WEIGHT_VARIATIONS),
        variation_config=VARIATION_CONFIG,
    log:
        "logs/select_background_weights/{sample}/batch{batch}.log",
    container:
        config["containers"]["analysis"]
    wildcard_constraints:
        sample=BACKGROUND_PATTERN,
    shell:
        shell_with_directories("""
        (
            python3 {input.script:q} {input.data:q} {output:q} signal {params.variations:q} -1 {params.variation_config:q}
        ) 2>&1 | tee {log:q}
        """)


