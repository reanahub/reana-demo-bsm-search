        """


rule select_background_shape_variation:
    input:
        WORKDIR + "/merged/generated/{sample}/batch{batch}.root",
    output:
        WORKDIR + "/selected/{sample}/{shapevar}/batch{batch}.root",
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/select.py {input} {output} signal {wildcards.shapevar}
        """


rule merge_background_shape_selection:
    input:
        lambda wildcards: selected_batch_files(wildcards.sample, wildcards.shapevar),
    output:
        WORKDIR + "/merged/selected/{sample}/{shapevar}.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


rule histogram_background_shape:
    input:
        WORKDIR + "/merged/selected/{sample}/{shapevar}.root",
    output:
        WORKDIR + "/hist/{sample}/{shapevar}.root",
    params:
        name=lambda wildcards: f"{wildcards.sample}_{wildcards.shapevar}",
        weight=lambda wildcards: sample_weight(wildcards.sample),
        variations="nominal",
        template=lambda wildcards: "{name}",
    container:
        config["containers"]["analysis"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        python code/histogram.py {input} {output} {params.name} {params.weight} {params.variations} '{params.template}'
        """


rule merge_background_sample_histograms:
    input:
        lambda wildcards: [
            WORKDIR + "/hist/" + wildcards.sample + "/weights.root",
            *expand(
                WORKDIR + "/hist/{sample}/{shapevar}.root",
                sample=wildcards.sample,
                shapevar=SHAPE_VARIATIONS,
            ),
        ],
    output:
        WORKDIR + "/hists/background/{sample}.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


rule merge_background_histograms:
    input:
        expand(
            WORKDIR + "/hists/background/{sample}.root",
            sample=BACKGROUND_SAMPLES,
        ),
    output:
        WORKDIR + "/hists/background.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input}
        """


rule merge_analysis_histograms:
    input:
        signal=WORKDIR + "/hists/signal.root",
        data=WORKDIR + "/hists/data.root",
        background=WORKDIR + "/hists/background.root",
    output:
        WORKDIR + "/hists/data_bkg_signal.root",
    container:
        config["containers"]["root"]
    shell:
        """
        source /usr/local/bin/thisroot.sh
        hadd -f {output} {input.signal} {input.data} {input.background}
        """


rule make_workspace:
    input:
        histograms=WORKDIR + "/hists/data_bkg_signal.root",
    output:
        workspace="results/workspace_combined_meas_model.root",
        xml=directory("xmldir"),
    container:
        config["containers"]["analysis"]
    shell:
        """
        workspace_prefix="{output.workspace}"
        workspace_prefix="${{workspace_prefix%_combined_meas_model.root}}"
        mkdir -p "$(dirname {output.workspace})" {output.xml}
        source /usr/local/bin/thisroot.sh
        python code/makews.py {input.histograms} "$workspace_prefix" {output.xml}
        """


rule plot:
    input:
        workspace="results/workspace_combined_meas_model.root",
    output:
        nominal_vals="plot/nominal_vals.yml",
        fit_results="plot/fit_results.yml",
        prefit="plot/prefit.pdf",
        postfit="plot/postfit.pdf",
    container:
        config["containers"]["analysis"]
    shell:
        """
        mkdir -p plot
        source /usr/local/bin/thisroot.sh
        hfquickplot write-vardef {input.workspace} combined {output.nominal_vals}
        hfquickplot plot-channel {input.workspace} combined channel1 x {output.nominal_vals} -c qcd,mc2,mc1,signal -o {output.prefit}
        hfquickplot fit {input.workspace} combined {output.fit_results}
        hfquickplot plot-channel {input.workspace} combined channel1 x {output.fit_results} -c qcd,mc2,mc1,signal -o {output.postfit}
        """


rule hepdata:
    input:
        workspace="results/workspace_combined_meas_model.root",
    output:
        zip="hepdata/submission.zip",
        submission="hepdata/submission.yaml",
        data="hepdata/data1.yaml",
    container:
        config["containers"]["analysis"]
    shell:
        """
        mkdir -p hepdata
        source /usr/local/bin/thisroot.sh
        python code/hepdata_export.py {input.workspace} {output.submission} {output.data}
        zip -j {output.zip} {output.submission} {output.data}
        """
